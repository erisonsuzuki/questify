{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Questify bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": ["user", "capabilities", "csrf_token"],
  "properties": {
    "user": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "namespace"],
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
            "kind": { "enum": ["guest", "account"] },
            "namespace": { "type": "string", "pattern": "^user:[0-9a-f-]{36}$" }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online_authority", "verified_account"],
      "properties": {
        "online_authority": { "type": "boolean" },
        "verified_account": { "type": "boolean" }
      }
    },
    "csrf_token": { "type": "string", "minLength": 1 }
  }
}
